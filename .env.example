# DeepSecurity Environment Variables
# Copy this file to .env and fill in with actual values

# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY — REQUIRED FOR PRODUCTION
# ═══════════════════════════════════════════════════════════════════════════════

# JWT secret for signing authentication tokens (cryptographically random, 32+ bytes)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_generated_secret_key_here

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════════════════════

# PostgreSQL connection URL
# Local development (Docker): postgresql+asyncpg://postgres:postgres@postgres:5432/deepsecurity
# Production: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/deepsecurity

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — DEFAULTS IN DOCKERFILE
# ═══════════════════════════════════════════════════════════════════════════════

# Path to the biometric identity database (face images)
# Default: /app/db/faces (inside Docker container)
# DB_PATH=/app/db/faces

# CORS origins allowed (comma-separated)
# Use '*' for development only; specify exact origins in production
# CORS_ORIGINS=http://localhost:5173,http://localhost

# JWT token lifetime in seconds (default: 86400 = 24 hours)
# JWT_LIFETIME_SECONDS=86400

# Disable native file picker (required in Docker; no X11 display)
# DISABLE_NATIVE_FILE_PICKER=true

# ═══════════════════════════════════════════════════════════════════════════════
# ANTI-SPOOFING (optional — requires PyTorch)
# ═══════════════════════════════════════════════════════════════════════════════

# Build-time: include PyTorch CPU in the Docker image to enable anti-spoofing.
# Must be set BEFORE building: docker compose build (or docker compose up --build)
# Adds ~160 MB to the image. Default: false
# INSTALL_ANTISPOOF=false

# Runtime: enable the anti-spoofing check on every detected face.
# Requires INSTALL_ANTISPOOF=true at build time (PyTorch must be installed).
# Can also be toggled at runtime via POST /api/settings. Default: false
# ANTISPOOF_ENABLED=false

# Confidence threshold for liveness (0.0–1.0). Faces with a FasNet score below
# this value are flagged as spoofed. Lower = stricter. Default: 0.5
# ANTISPOOF_THRESHOLD=0.5
